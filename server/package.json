{
  "name": "server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/index.js",
    "start": "node --env-file-if-exists=.env src/index.js",
    "db:init": "node --env-file-if-exists=.env db/init.js",
    "db:seed": "node --env-file-if-exists=.env db/seed.js",
    "test": "node --env-file-if-exists=.env --test test/*.test.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "pg": "^8.16.0"
  }
}
